; Engine configuration file.
; ZAWARUDO — simultaneous planning + short real-time execution.

config_version=5

[application]

config/name="ZAWARUDO"
config/version="0.2.0-playtest.1"
run/main_scene="res://scenes/Main.tscn"
boot_splash/image="res://assets/branding/zawarudo-splash.png"
boot_splash/bg_color=Color(0.015, 0.008, 0.027, 1)
boot_splash/fullsize=true
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/kenney/fonts/kenney-future.ttf"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
